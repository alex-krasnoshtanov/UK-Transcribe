# Copy to `.env` and fill in. Read by docker-compose.yml.

# faster-whisper model id or local path.
#   large-v3                                  broad 99-language baseline (has Ukrainian)
#   Yehor/whisper-large-v3-turbo-quantized-uk Ukrainian community fine-tune
WHISPER_MODEL=large-v3

# HuggingFace token. Optional but recommended: raises download rate limits and
# silences the "unauthenticated requests" warning on the large weights.
HF_TOKEN=

# Container image reference. Override once you push to your own registry.
IMAGE=ghcr.io/gfgf96/uk-transcribe:latest

# Host port to expose the web UI on.
PORT=8000

# Optional: restrict which GPUs the container may use (and therefore which the
# app picks the emptiest from). Default is all. Example: NVIDIA_VISIBLE_DEVICES=2,5
NVIDIA_VISIBLE_DEVICES=all
