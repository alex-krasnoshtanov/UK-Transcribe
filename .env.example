# For `docker compose up` (local / desktop). The cluster stack does not read
# this file; its settings are in deploy/cluster.yml.

# faster-whisper model id or local path.
#   large-v3                                  best quality (default)
#   Yehor/whisper-large-v3-turbo-quantized-uk Ukrainian community fine-tune
WHISPER_MODEL=large-v3

# auto (emptiest GPU, else CPU), cpu, or a GPU index.
DEVICE=auto

# Optional Hugging Face token: higher download rate limits.
HF_TOKEN=

# Host port for the dashboard.
PORT=3000
